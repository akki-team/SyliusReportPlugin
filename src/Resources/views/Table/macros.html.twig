{% macro list(report, labels, values) %}

{% if values|length > 0 %}
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>{{ '#' }}</th>
                    {% for label in labels %}
                        <th>{{ ('odiseo_sylius_report_plugin.ui.table.'~label)|trans }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for valueData in values %}
                    <tr id="{{ loop.index }}">
                        <td>{{ loop.index }}</td>
                        {% for value in valueData %}
                            <td>{% if '_money' in labels[loop.index0] %}$ {% endif %}{{ value }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p class="text-secondary mb-0">{{ 'odiseo_sylius_report_plugin.ui.there_are_no_reports_results'|trans }}</p>
{% endif %}

{% endmacro %}
