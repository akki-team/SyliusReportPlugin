{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% import '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' as breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as entete %}

{% form_theme form '@OdiseoSyliusReportPlugin/Form/theme.html.twig' %}

{# Meme composition que le fil d'ariane natif des ecrans de vue
   (@SyliusAdmin/shared/crud/show/content/header/breadcrumbs.html.twig) : premier maillon
   « Tableau de bord » et non « Administration », et dernier maillon actif. #}
{% set fil_ariane = [
    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
    {
        name: metadata.applicationName ~ '.ui.' ~ metadata.pluralName,
        url: path('odiseo_sylius_report_plugin_admin_report_index', configuration.vars.route.parameters|default({})),
        active: false
    },
    { name: resource.name, active: true }
] %}

{% block title %}{{ resource.name }} | {{ parent() }}{% endblock %}

{# Le gabarit de base ne fournit que le squelette HTML : la barre laterale et l'entete
   sont des composants a part, que Sylius appelle avec des prefixes explicites — ils
   s'incluent donc directement. La structure page-wrapper / page-header / page-body est
   celle des ecrans CRUD de Sylius 2. #}
{% block body %}
    {{ include('@SyliusAdmin/shared/crud/common/sidebar.html.twig') }}

    <div class="page-wrapper">
        {{ include('@SyliusAdmin/shared/crud/common/navbar.html.twig') }}

        <div class="page-header" data-sticky-header>
            {# Meme composition que l'entete natif : le fil d'ariane hors de la rangee, puis
               `row mt-3 row-gap-2` (sans `align-items-center`), et le titre par la macro
               `header.h1`. C'est le `mt-3` de la rangee qui creuse les 16 px entre le fil
               d'ariane et le titre : imbrique dans la colonne, le fil n'en beneficiait pas
               et l'ecart tombait a zero. #}
            <div class="container-xl">
                {{ breadcrumbs.breadcrumbs(fil_ariane) }}

                <div class="row mt-3 row-gap-2">
                    <div class="col-12 col-md-6">
                        <div class="d-md-flex gap-2 align-items-center">
                        {{ entete.h1(
                            resource.name,
                            null,
                            configuration.vars.subheader|default(null) is not empty ? configuration.vars.subheader|trans : null
                        ) }}
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="btn-list justify-content-md-end">
                            <a href="{{ path('odiseo_sylius_report_plugin_admin_report_update', {'id': resource.id}) }}" class="btn">
                                {{ ux_icon('tabler:pencil') }}
                                {{ 'sylius.ui.edit'|trans }}
                            </a>
                            <a href="{{ path('odiseo_sylius_report_plugin_admin_report_export', {'id': resource.id}) }}" class="btn btn-primary">
                                {{ ux_icon('tabler:download') }}
                                {{ 'odiseo_sylius_report_plugin.ui.export'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                {% set chemin_courant = path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) %}

                <div class="card mb-3">
                    <div class="card-header">
                        <h2 class="card-title">{{ 'sylius.ui.filters'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <form method="get" action="{{ chemin_courant }}">
                            {{ include('@OdiseoSyliusReportPlugin/_dataFetcherConfiguration.html.twig', {
                                'configurationForm': form.dataFetcherConfiguration
                            }) }}

                            <div class="btn-list mt-3">
                                <button type="submit" class="btn btn-primary">
                                    {{ ux_icon('tabler:filter') }}
                                    {{ 'sylius.ui.filter'|trans }}
                                </button>
                                <a href="{{ chemin_courant }}" class="btn">{{ 'sylius.ui.clear_filters'|trans }}</a>
                            </div>
                        </form>
                    </div>
                </div>

                <div id="report-results">
                    {{ render(controller('odiseo_sylius_report_plugin.controller.report::embedAction', {
                        'report': report,
                        'configuration': report.dataFetcherConfiguration
                    })) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="{{ asset('bundles/odiseosyliusreportplugin/js/report-auto-complete.js') }}"></script>
    <script src="{{ asset('bundles/odiseosyliusreportplugin/js/report.js') }}"></script>
{% endblock %}
