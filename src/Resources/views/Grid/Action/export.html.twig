{% set path = options.link.url|default(path(options.link.route, options.link.parameters)) %}
{% set message = action.label|default('odiseo_sylius_report_plugin.ui.export') %}

<a href="{{ path }}"
   class="btn btn-icon"
   data-bs-toggle="tooltip"
   data-bs-title="{{ message|trans }}"
>
    {{ ux_icon(action.icon|default('tabler:download')) }}
</a>
