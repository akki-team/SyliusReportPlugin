{% if configurationForm.timePeriod is defined %}
    <div class="row">
        {% for field in configurationForm.timePeriod %}
            <div class="col-md-6">
                {% if field.vars.name == 'end' %}
                    {{ form_label(field) }}
                    {{ form_widget(field) }}

                    <div class="form-check mt-2">
                        <input type="checkbox"
                               class="form-check-input"
                               id="timePeriod_end_today"
                               {{ field.vars.data is same as(null) ? 'checked' : '' }}
                        >
                        <label class="form-check-label" for="timePeriod_end_today">
                            {{ 'odiseo_sylius_report_plugin.ui.today'|trans }}
                        </label>
                    </div>
                {% else %}
                    {{ form_row(field) }}
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}

<div class="accordion" id="odiseo-report-more-filters">
    <div class="accordion-item">
        <div class="accordion-header">
            <button class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#odiseo-report-more-filters-content"
            >
                {{ 'odiseo_sylius_report_plugin.ui.more_filters'|trans }}
            </button>
        </div>

        <div id="odiseo-report-more-filters-content"
             class="accordion-collapse collapse"
             data-bs-parent="#odiseo-report-more-filters"
        >
            <div class="accordion-body">
                <div class="row">
                    {% for field in configurationForm %}
                        {% if field.vars.name != 'timePeriod' %}
                            <div class="col-md-6">{{ form_row(field) }}</div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
